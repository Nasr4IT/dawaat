# Copy this file to .env and fill in real values before starting the server.
# Never commit the real .env file.

# Set to "production" when deployed behind a real HTTPS reverse proxy
# (Nginx/Caddy) — this turns on the `secure` flag on the admin session
# cookie, so leave it unset for local HTTP development or the admin login
# cookie won't be sent back by the browser.
NODE_ENV=production

# Port the app listens on (put Nginx/Caddy in front of this on your VPS)
PORT=3000

# Secret used to sign admin session cookies.
# Generate one with: node scripts/generate-secret.js
SESSION_SECRET=

# Admin login for /admin
ADMIN_USERNAME=admin
# Do NOT put a plain password here. Generate a hash instead with:
#   node scripts/hash-password.js "yourPassword"
# then paste the printed line below.
ADMIN_PASSWORD_HASH=

# Public base URL of the site (used to build shareable invitation links
# and the Open Graph preview links shown when a link is shared in WhatsApp)
# e.g. https://www.avenocode.com or https://dawaat.avenocode.com
BASE_URL=https://www.avenocode.com

# WhatsApp business number (digits only, country code first, no + or spaces)
WHATSAPP_NUMBER=963900000000
WHATSAPP_MESSAGE=مرحباً، أرغب بمعرفة المزيد عن دعوات الزفاف الرقمية

# Instagram profile URL
INSTAGRAM_URL=https://instagram.com/your_handle

# Optional: email alert whenever a new lead comes in from the landing page.
# Leave all of these blank to skip email notifications entirely — the site
# works fine without them (new leads still show up in /admin with a "جديد"
# badge). Any standard SMTP provider works (Gmail app password, SendGrid,
# Mailgun, your host's own SMTP, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
