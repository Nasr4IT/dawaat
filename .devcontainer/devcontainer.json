{
  "name": "Dawaat (try it in Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install && node scripts/codespaces-setup.js",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Dawaat app",
      "onAutoForward": "openPreview"
    }
  }
}
