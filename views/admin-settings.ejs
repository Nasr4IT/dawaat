<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>الإعدادات العامة | لوحة التحكم</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #0a0a0a;
      color: #f5efe0;
      font-family: 'Tajawal', 'Segoe UI', sans-serif;
      padding: 2rem 1rem;
      min-height: 100vh;
    }
    .container {
      max-width: 860px;
      margin: 0 auto;
      background: #15120c;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid #2a241a;
      box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    }
    h1 {
      font-size: 28px;
      font-weight: 700;
      color: #d8b565;
      border-bottom: 1px solid #2a241a;
      padding-bottom: 0.75rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    h1 small {
      font-size: 16px;
      font-weight: 400;
      color: #a89a7c;
    }
    .back-link {
      color: #d8b565;
      text-decoration: none;
      font-size: 14px;
      display: inline-block;
      margin-bottom: 1.5rem;
      border: 1px solid #2a241a;
      padding: 6px 14px;
      border-radius: 20px;
      transition: 0.2s;
    }
    .back-link:hover {
      background: #2a241a;
    }

    .error-box {
      background: #3d1a1a;
      color: #ffbaba;
      border: 1px solid #a33;
      padding: 12px 18px;
      border-radius: 8px;
      margin-bottom: 1.5rem;
    }

    hr {
      border: none;
      border-top: 1px solid #2a241a;
      margin: 2.5rem 0;
    }

    .section-title {
      font-size: 20px;
      font-weight: 600;
      color: #d8b565;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-desc {
      color: #a89a7c;
      font-size: 14px;
      margin-bottom: 1rem;
    }

    .preview-box {
      background: #1e1912;
      border: 1px solid #2a241a;
      border-radius: 8px;
      padding: 1rem;
      margin: 0.5rem 0 1rem 0;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }
    .preview-box img {
      max-width: 120px;
      max-height: 120px;
      border-radius: 8px;
      border: 1px solid #3a3226;
      background: #0a0a0a;
      padding: 4px;
    }
    .preview-box audio {
      max-width: 260px;
      background: #0a0a0a;
      border-radius: 20px;
    }
    .preview-box .file-name {
      color: #c4b69a;
      font-size: 13px;
    }
    .btn-delete {
      background: none;
      border: 1px solid #7a4a4a;
      color: #d48a8a;
      padding: 4px 14px;
      border-radius: 16px;
      cursor: pointer;
      font-size: 13px;
      transition: 0.2s;
    }
    .btn-delete:hover {
      background: #3d1a1a;
      border-color: #a33;
    }

    .upload-form {
      background: #1a1610;
      border: 1px dashed #3a3226;
      border-radius: 8px;
      padding: 1.2rem 1.5rem;
      margin-top: 0.3rem;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .upload-form input[type="file"] {
      background: #0a0a0a;
      color: #c4b69a;
      border: 1px solid #2a241a;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 13px;
      flex: 1 1 200px;
    }
    .upload-form input[type="file"]::file-selector-button {
      background: #2a241a;
      color: #d8b565;
      border: none;
      padding: 4px 12px;
      border-radius: 4px;
      cursor: pointer;
    }
    .upload-form button {
      background: #d8b565;
      color: #0a0a0a;
      border: none;
      padding: 8px 24px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: 0.2s;
    }
    .upload-form button:hover {
      background: #c99a3a;
    }

    .sticker-gallery {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin: 1rem 0;
    }
    .sticker-gallery .item {
      background: #1e1912;
      border: 1px solid #2a241a;
      border-radius: 8px;
      padding: 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .sticker-gallery .item img {
      max-width: 80px;
      max-height: 80px;
      border-radius: 4px;
    }
    .sticker-gallery .item form {
      margin: 0;
    }
    .sticker-gallery .item .btn-delete {
      font-size: 11px;
      padding: 2px 12px;
    }
    .empty-message {
      color: #6a5e4a;
      font-style: italic;
      font-size: 14px;
    }

    .footer-actions {
      margin-top: 2rem;
      text-align: center;
      border-top: 1px solid #2a241a;
      padding-top: 1.5rem;
    }
    .footer-actions a {
      color: #d8b565;
      text-decoration: none;
      font-size: 15px;
    }
    .footer-actions a:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      .container { padding: 1rem; }
      .preview-box { flex-direction: column; align-items: flex-start; }
      .upload-form { flex-direction: column; align-items: stretch; }
      .upload-form input[type="file"] { flex: 1; }
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>⚙️ الإعدادات العامة <small>اختيارية</small></h1>
    <a href="/admin" class="back-link">← العودة إلى لوحة التحكم</a>

    <% if (error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>

    <!-- ========== MUSIC ========== -->
    <div class="section-title">🎵 الموسيقى الخلفية</div>
    <div class="section-desc">سيظهر زر تشغيل الموسيقى في صفحة الدعوة. اختياري.</div>
    <% if (musicUrl) { %>
      <div class="preview-box">
        <audio controls src="<%= musicUrl %>"></audio>
        <span class="file-name"><%= musicUrl.split('/').pop() %></span>
        <form method="POST" action="/admin/settings/music/delete" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-delete">حذف</button>
        </form>
      </div>
    <% } else { %>
      <p class="empty-message">لا يوجد ملف موسيقى مرفوع.</p>
    <% } %>
    <form method="POST" action="/admin/settings/music" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="music_file" accept="audio/*" required />
      <button type="submit">رفع</button>
    </form>
    <hr>

    <!-- ========== HERO STICKER ========== -->
    <div class="section-title">🖼️ ملصق البطل</div>
    <div class="section-desc">يستبدل رسم العروسين الافتراضي في أعلى الدعوة. اختياري.</div>
    <% if (heroStickerUrl) { %>
      <div class="preview-box">
        <img src="<%= heroStickerUrl %>" alt="hero sticker" />
        <span class="file-name"><%= heroStickerUrl.split('/').pop() %></span>
        <form method="POST" action="/admin/settings/hero-sticker/delete" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-delete">حذف</button>
        </form>
      </div>
    <% } else { %>
      <p class="empty-message">لا يوجد ملصق بطل مرفوع.</p>
    <% } %>
    <form method="POST" action="/admin/settings/hero-sticker" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="sticker_file" accept="image/*" required />
      <button type="submit">رفع</button>
    </form>
    <hr>

    <!-- ========== BRIDE STICKER ========== -->
    <div class="section-title">👰 ملصق العروس</div>
    <div class="section-desc">يظهر في الزاوية اليمنى السفلى من صفحة الدعوة. اختياري.</div>
    <% if (brideStickerUrl) { %>
      <div class="preview-box">
        <img src="<%= brideStickerUrl %>" alt="bride sticker" />
        <span class="file-name"><%= brideStickerUrl.split('/').pop() %></span>
        <form method="POST" action="/admin/settings/bride-sticker/delete" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-delete">حذف</button>
        </form>
      </div>
    <% } else { %>
      <p class="empty-message">لا يوجد ملصق للعروس مرفوع.</p>
    <% } %>
    <form method="POST" action="/admin/settings/bride-sticker" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="sticker_file" accept="image/*" required />
      <button type="submit">رفع</button>
    </form>
    <hr>

    <!-- ========== GROOM STICKER ========== -->
    <div class="section-title">🤵 ملصق العريس</div>
    <div class="section-desc">يظهر في الزاوية اليسرى السفلى من صفحة الدعوة. اختياري.</div>
    <% if (groomStickerUrl) { %>
      <div class="preview-box">
        <img src="<%= groomStickerUrl %>" alt="groom sticker" />
        <span class="file-name"><%= groomStickerUrl.split('/').pop() %></span>
        <form method="POST" action="/admin/settings/groom-sticker/delete" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-delete">حذف</button>
        </form>
      </div>
    <% } else { %>
      <p class="empty-message">لا يوجد ملصق للعريس مرفوع.</p>
    <% } %>
    <form method="POST" action="/admin/settings/groom-sticker" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="sticker_file" accept="image/*" required />
      <button type="submit">رفع</button>
    </form>
    <hr>

    <!-- ========== BACKGROUND STICKERS ========== -->
    <div class="section-title">🌿 ملصقات الخلفية</div>
    <div class="section-desc">تظهر كعناصر عائمة في خلفية صفحة الدعوة. يمكنك رفع عدة صور.</div>
    <% if (backgroundStickers && backgroundStickers.length) { %>
      <div class="sticker-gallery">
        <% backgroundStickers.forEach((s) => { %>
          <div class="item">
            <img src="<%= s.url %>" alt="background sticker" />
            <form method="POST" action="/admin/settings/stickers/<%= s.id %>/delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn-delete">حذف</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="empty-message">لا توجد ملصقات خلفية مرفوعة.</p>
    <% } %>
    <form method="POST" action="/admin/settings/stickers" enctype="multipart/form-data" class="upload-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="file" name="sticker_file" accept="image/*" required />
      <button type="submit">رفع</button>
    </form>
    <hr>

    <div class="footer-actions">
      <a href="/admin">← العودة إلى لوحة التحكم</a>
    </div>
  </div>
</body>
</html>